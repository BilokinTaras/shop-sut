# shop-sut local configuration. `make up` copies this file to .env on first run.
# Every value below is a TEST-ONLY value for a stand bound to 127.0.0.1.
# None of them is a secret; never reuse them anywhere else.

# Host ports (127.0.0.1 only). Change here if a port is taken.
SHOP_BACKEND_PORT=9000
SHOP_STOREFRONT_PORT=8000
SHOP_POSTGRES_PORT=55432
SHOP_REDIS_PORT=56379

# Database
SHOP_POSTGRES_PASSWORD=qa-local-postgres-password
QA_DB_READONLY_PASSWORD=qa-local-readonly-password

# Medusa secrets (test-only)
SHOP_JWT_SECRET=qa-local-jwt-secret-not-for-production
SHOP_COOKIE_SECRET=qa-local-cookie-secret-not-for-production

# Test admin created by the bootstrap
QA_ADMIN_EMAIL=qa-admin@example.com
QA_ADMIN_PASSWORD=qa-admin-local-password

# Storefront country (one of the seeded Europe region countries)
QA_STOREFRONT_COUNTRY=dk

# Number of Medusa server processes (Node.js cluster). Empty = one process (default).
# Used by the performance experiment in shop-performance-k6.
SHOP_MEDUSA_CLUSTER=
